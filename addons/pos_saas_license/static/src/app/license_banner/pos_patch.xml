<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <!-- 1. Inject LicenseBanner ke bagian atas Navbar POS -->
    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-topheader')]" position="before">
            <LicenseBanner
                state="saasLicenseState"
                message="saasLicenseMessage"
                daysLeft="saasLicenseDaysLeft"/>
        </xpath>
    </t>

    <!-- 2. Nonaktifkan tombol Payment jika lisensi expired atau invalid (read-only mode) -->
    <t t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('pay-order-button')]" position="attributes">
            <attribute name="t-att-disabled">
                !this.pos.accessRight.disableClickPayment or
                this.pos.session.license_state === 'expired' or
                this.pos.session.license_state === 'invalid'
            </attribute>
        </xpath>
    </t>
</templates>
