<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action: Pemeriksaan lisensi harian pukul 00:05 UTC -->
        <record id="ir_cron_pos_saas_license_check" model="ir.cron">
            <field name="name">POS SaaS License: Daily Expiration Check</field>
            <field name="model_id" ref="model_pos_saas_license"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily_check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
