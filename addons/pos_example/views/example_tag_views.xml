<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_example_tag_tree" model="ir.ui.view">
        <field name="name">pos_example.tag.tree</field>
        <field name="model">pos_example.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_pos_example_tag_form" model="ir.ui.view">
        <field name="name">pos_example.tag.form</field>
        <field name="model">pos_example.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_example_tag" model="ir.actions.act_window">
        <field name="name">Example Tags</field>
        <field name="res_model">pos_example.tag</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_pos_example_root" name="POS Example"/>
    <menuitem id="menu_pos_example_tag"
        parent="menu_pos_example_root"
        action="action_pos_example_tag"/>
</odoo>
