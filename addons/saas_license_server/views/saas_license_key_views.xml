<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_saas_license_key_list" model="ir.ui.view">
        <field name="name">saas.license.key.list</field>
        <field name="model">saas.license.key</field>
        <field name="arch" type="xml">
            <list string="Signing Keys">
                <field name="name"/>
                <field name="key_id"/>
                <field name="public_key_b64"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="license_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_saas_license_key_form" model="ir.ui.view">
        <field name="name">saas.license.key.form</field>
        <field name="model">saas.license.key</field>
        <field name="arch" type="xml">
            <form string="Signing Key">
                <header>
                    <button name="action_generate_keypair"
                            string="Generate Keypair (Auto)"
                            type="object"
                            class="btn-primary"
                            confirm="Peringatan: Membuat pasangan kunci baru akan menimpa private key saat ini jika sudah ada! Lanjutkan?"
                            groups="saas_license_server.group_saas_license_admin"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Misal: Production 2026 Key"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="key_id" placeholder="Misal: prod2026"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="license_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Public Key (Untuk POS Client)" name="public_key">
                            <div class="alert alert-info" role="alert">
                                <strong>Panduan:</strong> Salin string Public Key di bawah ini dan daftarkan ke modul POS client pada file <code>license_verifier.py</code> (dictionary <code>PUBLIC_KEYS</code>).
                            </div>
                            <group>
                                <field name="public_key_b64" widget="CopyClipboardChar" readonly="1" class="font-monospace"/>
                            </group>
                        </page>
                        <page string="Private Key (PKCS8 PEM)" name="private_key" groups="base.group_system">
                            <div class="alert alert-danger" role="alert">
                                <strong>Sangat Rahasia (Super Admin):</strong> Private Key ini digunakan untuk menandatangani token lisensi. Jangan pernah membagikan teks di bawah ini ke pihak luar.
                            </div>
                            <field name="private_key_pem" widget="text" password="True" class="font-monospace" placeholder="-----BEGIN PRIVATE KEY----- ..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_saas_license_key" model="ir.actions.act_window">
        <field name="name">Signing Keys</field>
        <field name="res_model">saas.license.key</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada Signing Key. Buat kunci Ed25519 pertama Anda!
            </p>
        </field>
    </record>
</odoo>
