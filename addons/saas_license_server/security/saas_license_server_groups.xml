<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_saas_license">
        <field name="name">POS License Management</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_saas_license_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_saas_license"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_saas_license_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_saas_license"/>
        <field name="implied_ids" eval="[(4, ref('group_saas_license_viewer'))]"/>
    </record>

    <record id="group_saas_license_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_saas_license"/>
        <field name="implied_ids" eval="[(4, ref('group_saas_license_manager'))]"/>
    </record>

    <!-- Inherit base.group_system so system administrators automatically inherit saas_license_admin -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_saas_license_admin'))]"/>
    </record>

    <!-- Assign admin and root users to saas_license_admin -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_saas_license_admin'))]"/>
    </record>
    <record id="base.user_root" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_saas_license_admin'))]"/>
    </record>
</odoo>
