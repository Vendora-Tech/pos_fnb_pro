# ==============================================================================
# Odoo 20 SaaS POS Environment Configuration Template
# Copy this file to .env and change credentials before running docker compose
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_USER=odoo20_user
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=postgres

# Odoo Server Configuration
ODOO_WEB_PORT=10020
ODOO_CHAT_PORT=20020
ODOO_MASTER_PASSWORD=your_strong_master_admin_password_here
